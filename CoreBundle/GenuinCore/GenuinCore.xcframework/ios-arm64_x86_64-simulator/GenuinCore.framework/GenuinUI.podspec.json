{
  "name": "GenuinUI",
  "version": "0.0.1",
  "summary": "GenuinUI is an SDK that consist feeds for which user has shown interest.",
  "description": "This is a home sdk of Genuin",
  "homepage": "https://ankit_begenuin@bitbucket.org/genuindev/genuin_demo_sdk_ios.git",
  "license": "MIT",
  "authors": {
    "Ankit Gabani": "ankit@begenuin.com"
  },
  "platforms": {
    "ios": "15.0"
  },
  "source": {
    "git": "git@bitbucket.org:genuindev/genuin_demo_sdk_ios.git",
    "tag": "0.0.1"
  },
  "source_files": [
    "GenuinUI/Classes/**/*.{swift,plist,xcdatamodeld,momd,h,m,storyboard,xib}",
    "GenuinUI/Classes/Database/genuin.xcdatamodeld",
    "GenuinUI/Classes/Database/genuin.xcdatamodeld/*.xcdatamodel",
    "GenuinUI/GenuinUI.h"
  ],
  "exclude_files": "Classes/Exclude",
  "swift_versions": "5.0",
  "preserve_paths": "GenuinUI/Classes/Database/genuin.xcdatamodeld",
  "resource_bundles": {
    "GenuinUI_Privacy": [
      "PrivacyInfo.xcprivacy"
    ]
  },
  "public_header_files": [
    "GenuinUI/GenuinUI.h",
    "GenuinUI/Classes/Libraries/XHScrollMenu/Source/*.h",
    "GenuinUI/Classes/Libraries/CustomViews/*.h"
  ],
  "resources": [
    "GenuinUI/Resources/**/*.{storyboard,xib,xcassets,json,png,gif,jpg,mp4,ttf,tflite,strings}",
    "GenuinUI/Classes/Database/genuin.xcdatamodeld",
    "GenuinUI/Classes/Database/genuin.xcdatamodeld/*.xcdatamodel",
    "GenuinUI/PrivacyInfo.xcprivacy"
  ],
  "dependencies": {
    "URLEmbeddedView": [
      "~> 0.18.0"
    ],
    "GenuinCore": []
  },
  "swift_version": "5.0"
}
