{
  "name": "GenuinCamera",
  "version": "0.0.1",
  "summary": "GenuinCamera is an SDK that consist feeds for which user has shown interest.",
  "description": "This is a home sdk of Genuin",
  "homepage": "https://ankit_begenuin@bitbucket.org/genuindev/genuin_demo_sdk_ios.git",
  "license": "MIT",
  "authors": {
    "Ankit Gabani": "ankit@begenuin.com"
  },
  "platforms": {
    "ios": "15.0"
  },
  "source": {
    "git": "git@bitbucket.org:genuindev/genuin_demo_sdk_ios.git",
    "tag": "0.0.1"
  },
  "source_files": [
    "GenuinCamera/Classes/**/*.{swift,plist,xcdatamodeld,momd,h,m,storyboard,xib}",
    "GenuinCamera/Classes/Database/genuin.xcdatamodeld",
    "GenuinCamera/Classes/Database/genuin.xcdatamodeld/*.xcdatamodel",
    "GenuinCamera/GenuinCamera.h"
  ],
  "exclude_files": "Classes/Exclude",
  "swift_versions": "5.0",
  "preserve_paths": "GenuinCamera/Classes/Database/genuin.xcdatamodeld",
  "resource_bundles": {
    "GenuinCamera_Privacy": [
      "PrivacyInfo.xcprivacy"
    ]
  },
  "public_header_files": [
    "GenuinCamera/GenuinCamera.h",
    "GenuinCamera/Classes/Libraries/XHScrollMenu/Source/*.h",
    "GenuinCamera/Classes/Libraries/CustomViews/*.h"
  ],
  "resources": [
    "GenuinCamera/Resources/**/*.{storyboard,xib,xcassets,json,png,gif,jpg,mp4,ttf,tflite,strings}",
    "GenuinCamera/Classes/Database/genuin.xcdatamodeld",
    "GenuinCamera/Classes/Database/genuin.xcdatamodeld/*.xcdatamodel",
    "GenuinCamera/PrivacyInfo.xcprivacy"
  ],
  "dependencies": {
    "Giphy": [
      "~> 2.1.22"
    ],
    "GenuinUI": [],
    "GenuinCore": []
  },
  "vendored_frameworks": [
    "GenuinCamera/Frameworks/ffmpeg-kit-min-gpl-6.0-ios-xcframework/libswscale.xcframework",
    "GenuinCamera/Frameworks/ffmpeg-kit-min-gpl-6.0-ios-xcframework/libswresample.xcframework",
    "GenuinCamera/Frameworks/ffmpeg-kit-min-gpl-6.0-ios-xcframework/libavutil.xcframework",
    "GenuinCamera/Frameworks/ffmpeg-kit-min-gpl-6.0-ios-xcframework/libavformat.xcframework",
    "GenuinCamera/Frameworks/ffmpeg-kit-min-gpl-6.0-ios-xcframework/libavfilter.xcframework",
    "GenuinCamera/Frameworks/ffmpeg-kit-min-gpl-6.0-ios-xcframework/libavdevice.xcframework",
    "GenuinCamera/Frameworks/ffmpeg-kit-min-gpl-6.0-ios-xcframework/libavcodec.xcframework",
    "GenuinCamera/Frameworks/ffmpeg-kit-min-gpl-6.0-ios-xcframework/ffmpegkit.xcframework"
  ],
  "swift_version": "5.0"
}
